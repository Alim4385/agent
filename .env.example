# Nümunə konfiqurasiya. Dəyərləri ətraf mühit dəyişəni kimi verin:
#   export LLM_BASE_URL=http://127.0.0.1:8080/v1
# və ya: set -a; . ./.env; set +a

# --- LLM serveri (OpenAI-uyğun /v1/chat/completions) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_STREAM=true

# --- Axtarış ---
SEARCH_MAX_RESULTS=6
SEARCH_RETRIES=2
SEARCH_BACKOFF=1.5
SEARCH_TIMEOUT=15

# --- Tam səhifə mətninin çəkilməsi ---
FETCH_ENABLED=true
FETCH_TIMEOUT=8
FETCH_MAX_CHARS=4000
FETCH_MAX_BYTES=2000000
FETCH_CONCURRENCY=5

# --- Reranking ---
RERANK_TOP_K=4
EMBEDDINGS_ENABLED=true

# --- Şəbəkə ---
# Bəzi saytlar sadə bot UA-sını bloklayır; lazım gələrsə dəyişin.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# --- Söhbət / logging ---
MAX_HISTORY_TURNS=6
LOG_LEVEL=INFO
